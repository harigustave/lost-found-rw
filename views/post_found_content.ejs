<style>
    .required_item {
        color: red;
        margin-left: 2px;
    }

    label, h3, h4 {
        color: silver;
    }

    form {
        width: 50% !important; 
        margin: auto;
    }

    .double-size {
        width: 100%;
    }

    .double-btn {
        width: 100%;
        padding: 10px;
        font-weight: bold;
    }

    /* Small screens adjustments */
    @media (max-width: 767px) {
        form {
            width: 95% !important;
            margin: 0 auto;
        }

        input.form-control,
        select.form-select,
        .double-btn {
            font-size: 0.9rem;
            padding: 8px;
        }

        h4 {
            font-size: 1.2rem;
        }

        label {
            font-size: 0.9rem;
        }
    }

    /* Super small screens: 480px and below */
    @media (max-width: 480px) {
        form {
            width: 100% !important;   /* full width */
            margin: 0 auto;
            padding: 0 10px;          /* small padding */
        }

        input.form-control,
        select.form-select,
        .double-btn {
            width: 100%;              /* full width */
            font-size: 0.85rem;       /* smaller font */
            padding: 7px;             /* reduce padding */
        }

        h4.text-danger {
            font-size: 1.1rem;
            margin-bottom: 15px;
        }

        /* Ensure spacing between stacked elements */
        .mb-3 {
            margin-bottom: 12px !important;
        }
    }

</style>

<h4 class="text-silver text-center mb-4">Menyekanisha Icyangombwa Wabonye</h4>

<form action="/items/create" method="post" enctype="multipart/form-data" class="mb-4">
    
    <input type="hidden" name="kind" value="found">

    <div class="mb-3">
        <select name="item_type" class="form-select double-size" required>
            <option value="" disabled selected>Hitamo ubwoko bw'icyangombwa</option>
            <option value="ID Card">Indangamuntu</option>
            <option value="Passport">Pasiporo</option>
            <option value="Insurance Card">Ikarita y'ubwishingizi</option>
            <option value="Yellow Card">Karite Jone</option>               
            <option value="Driving License">Perimi yo gutwara ikinyabiziga</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Amazina yanditseho</label><span class="required_item">*</span>
        <input type="text" name="item_name" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Nimero y'icyangombwa</label><span class="required_item">*</span>
        <input type="text" name="item_number" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Ahantu cyabonekeye</label><span class="required_item">*</span>
        <input type="text" name="place" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Amazina yawe</label><span class="required_item">*</span>
        <input type="text" name="poster_name" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Telefoni yawe</label><span class="required_item">*</span>
        <input type="tel" name="poster_phone" class="form-control double-size" required>
    </div>

    <button class="btn btn-success double-btn">Ohereza Amakuru</button>
</form>
