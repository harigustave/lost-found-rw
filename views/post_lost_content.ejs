<style>
    .required_item{
        color: red;
        margin-left: 2px;
    }

    label,h3{
        color: silver;
    }

    form {
        width: 50% !important;
        margin: auto;
    }
    
    /* Small screens: width 100% */
    @media (max-width: 767px) {
        form {
            width: 100%;
            margin: auto;
        }
    }
</style>

<form action="/items/create" method="post" enctype="multipart/form-data" class="mb-4">

    <input type="hidden" name="kind" value="lost">

    <div class="mb-3">
        <label>Card Type</label><span class="required_item">*</span>
        <select name="item_type" class="form-select double-size" required>
            <option value="" selected disabled>Choose item type</option>
            <option value="ID Card">ID Card</option>
            <option value="Bank Card">Bank Card</option>
            <option value="Passport">Passport</option>
            <option value="Driving License">Driving License</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Name on Card</label><span class="required_item">*</span>
        <input type="text" name="item_name" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Card Number</label><span class="required_item">*</span>
        <input type="text" name="item_number" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Place Lost</label><span class="required_item">*</span>
        <input type="text" name="place" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Card Photo</label><span style="color: silver; font-size: 0.75rem;color: red;"> (Please hide card personal info <span style="font-weight: bold;font-size: 0.70rem;">Card No, Date of Birth, CVC</span> before taking the photo)</span><span class="required_item"></span>
        <input type="file" name="photo" class="form-control double-size">
    </div>

    <div class="mb-3">
        <label>Your Name</label><span class="required_item">*</span>
        <input type="text" name="poster_name" class="form-control double-size" required>
    </div>

    <div class="mb-3">
        <label>Your Phone</label><span class="required_item">*</span>
        <input type="text" name="poster_phone" class="form-control double-size" required>
    </div>

    <button class="btn btn-danger double-btn">Report Lost Item</button>

</form>

<!-- Footer -->
<footer class="text-center mt-4 mb-4" style="color: silver;font-size: 0.73rem;font-weight: normal;">
    Lost & Found (RW). H&G Tech Ltd, All Rights Reserved <%= new Date().getFullYear() %>
</footer>
