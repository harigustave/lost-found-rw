<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lost & Found Rwanda</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <style>
        body {
            overflow-x: hidden;
        }

        /* Snackbar */
        #snackbar {
            visibility: visible;
            min-width: 300px;
            max-width: 90%;
            background: #4CAF50;
            color: white;
            text-align: center;
            border-radius: 6px;
            padding: 14px;
            font-size: 1rem;
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 9999;
            animation: fadein 0.5s, fadeout 0.5s 7s;
            animation-fill-mode: forwards;
        }

        @media (max-width: 576px) {
            #snackbar {
                left: 50%;
                right: auto;
                transform: translateX(-50%);
                bottom: 20px;
            }
        }

        @keyframes fadein {
            from { opacity: 0; bottom: 10px; }
            to { opacity: 1; bottom: 30px; }
        }

        @keyframes fadeout {
            from { opacity: 1; bottom: 30px; }
            to { opacity: 0; bottom: 10px; }
        }

        /* Navbar */
        .navbar {
            background-color: #213448;
            padding-top: 5px;      /* reduced padding */
            padding-bottom: 5px;   /* reduced padding */
        }

        .navbar-brand img {
            height: 70px; /* reduced by 10px */
        }

        @media (max-width: 576px) {
            .navbar-brand img {
                height: 45px; /* reduced by 10px */
            }
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255,255,255,1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* Hide separators on mobile */
        @media (max-width: 991px) {
            .nav-separator {
                display: none;
            }
            .navbar-nav .nav-link {
                padding: 5px 0; /* reduce padding to match navbar height */
                text-align: center;
            }
        }

        /* Search inputs */
        .search-input,
        .search-select {
            height: 50px;
            font-size: 1rem;
            max-width: 100%;
        }

        .search-btn {
            background-color: orange;
            width: 70px;
        }

        .search-btn:hover {
            background-color: #D18700;
        }

        .card-title,
        .card-text {
            font-size: 0.95rem;
        }

        @media (max-width: 576px) {
            .card-title,
            .card-text {
                font-size: 0.9rem;
            }
        }

        /* ================= SKELETON ================= */
        .skeleton {
            background: linear-gradient(
                90deg,
                #e0e0e0 25%,
                #f2f2f2 37%,
                #e0e0e0 63%
            );
            background-size: 400% 100%;
            animation: skeleton-loading 1.4s ease infinite;
            border-radius: 6px;
        }

        @keyframes skeleton-loading {
            0% { background-position: 100% 50%; }
            100% { background-position: 0 50%; }
        }

        .skeleton-img { height: 220px; width: 100%; }
        .skeleton-text { height: 14px; margin-bottom: 10px; }
        .skeleton-text.short { width: 60%; }
        .skeleton-btn { height: 36px; width: 100%; }

        /* Pagination */
        .pagination .page-item.active .page-link {
            background-color: #213448;
            border-color: #213448;
            color: white;
        }
        .pagination .page-link { color: #213448; }
        .pagination .page-item.disabled .page-link { color: #ccc; }

        /* Footer hidden on mobile */
        @media (max-width: 576px) {
            footer { display: none; }
        }
    </style>
</head>
<body>

<% if (success && success.length > 0) { %>
    <div id="snackbar"><%= success %></div>
<% } %>

<% if (error && error.length > 0) { %>
    <div id="snackbar" class="bg-danger"><%= error %></div>
<% } %>

<nav class="navbar navbar-expand-lg fixed-top navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/items">
            <img src="/images/lostfoundcroped.png" alt="Logo">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a href="/" class="nav-link" style="color:#FFFFFF; font-size: 17px;">Home</a>
                </li>
                <li class="nav-separator"><span class="nav-link" style="color: #F5C857;">|</span></li>
                <li class="nav-item">
                    <a href="/items/post-lost" class="nav-link" style="color:#FFFFFF; font-size: 17px;">Report Lost Item</a>
                </li>
                <li class="nav-separator"><span class="nav-link" style="color: #F5C857;">|</span></li>
                <li class="nav-item">
                    <a href="/items/post-found" class="nav-link" style="color:#FFFFFF; font-size: 17px;">Report Found Item</a>
                </li>
                <li class="nav-separator"><span class="nav-link" style="color: #F5C857;">|</span></li>
                <li class="nav-item">
                    <a href="#" class="nav-link" style="color:#FFFFFF; font-size: 17px;">Download Certificate</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container" style="margin-top: 120px;">
    <%- include(viewContent) %>
</div>

<footer class="text-center text-muted" style="font-size: 12px; z-index: 1000;margin-bottom: 10px;">
    H&G Tech Ltd, All Rights Reserved <%= new Date().getFullYear() %>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const snackbar = document.getElementById("snackbar");
        if (snackbar) {
            setTimeout(() => {
                snackbar.style.opacity = "0";
                snackbar.style.visibility = "hidden";
            }, 8000);
        }
    });
</script>

</body>
</html>