<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Lost & Found Rwanda</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            overflow-x: hidden;
        }

        /* Snackbar fixed and centered on mobile, minimal height */
        #snackbar {
            visibility: visible;
            display: inline-block;       /* shrink to content width */
            max-width: 90%;
            background: #4CAF50;
            color: white;
            text-align: center;
            border-radius: 6px;
            padding: 10px 20px;          /* adjust padding */
            font-size: 0.95rem;
            position: fixed;
            left: 50%;
            bottom: 20px;
            transform: translateX(-50%);
            z-index: 9999;
            animation: fadein 0.5s, fadeout 0.5s 7s;
            animation-fill-mode: forwards;
            line-height: 1.2;            /* tight line-height */
        }

        /* optional smaller font for phones */
        @media (max-width: 576px) {
            #snackbar {
                font-size: 0.85rem;
                padding: 8px 16px;
            }
        }

        @keyframes fadein {
            from { opacity: 0; transform: translate(-50%, -60%); }
            to   { opacity: 1; transform: translate(-50%, -50%); }
        }

        @keyframes fadeout {
            from { opacity: 1; transform: translate(-50%, -50%); }
            to   { opacity: 0; transform: translate(-50%, -60%); }
        }

        /* Navbar */
        .navbar {
            background-color: #1E90FF;
            padding-top: 5px;      /* reduced padding */
            padding-bottom: 5px;   /* reduced padding */
        }

        .nav-link {
            color: #ffffff;
            font-size: 17px;
        }

        .nav-link.active {
            color: orange !important; /* Orange */
            font-weight: 600;
        }

        .navbar-brand img {
            height: 70px; /* reduced by 10px */
        }

        @media (max-width: 576px) {
            .navbar-brand img {
                height: 45px; /* reduced by 10px */
            }
        }

        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255,255,255,1%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        .dropdown-menu a:hover {
            background-color: #F5C857;
            color: #000;
        }

        /* Hide separators on mobile */
        @media (max-width: 991px) {
            .nav-separator {
                display: none;
            }
            .navbar-nav .nav-link {
                padding: 5px 0; /* reduce padding to match navbar height */
                text-align: center;
            }
        }

        /* Search inputs */
        .search-input,
        .search-select {
            height: 50px;
            font-size: 1rem;
            max-width: 100%;
        }

        .card-title,
        .card-text {
            font-size: 0.95rem;
        }

        @media (max-width: 576px) {
            .card-title,
            .card-text {
                font-size: 0.9rem;
            }
        }

        /* Pagination */
        .pagination .page-item.active .page-link {
            background-color: #213448;
            border-color: #213448;
            color: white;
        }
        .pagination .page-link { color: #213448; }
        .pagination .page-item.disabled .page-link { color: #ccc; }

        /* Footer hidden on mobile */
        @media (max-width: 576px) {
            footer { display: none; }
        }
    </style>
</head>
<body>

<% if (success && success.length > 0) { %>
    <div id="snackbar"><%= success %></div>
<% } %>

<% if (error && error.length > 0) { %>
    <div id="snackbar" class="bg-danger"><%= error %></div>
<% } %>

<nav class="navbar navbar-expand-lg fixed-top navbar-dark">
    <div class="container">
        <a class="navbar-brand" href="/items">
            <img src="/images/lostfoundcroped.png" alt="Logo">
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto align-items-lg-center">
                <li class="nav-item">
                    <a href="/items"
                    class="nav-link <%= currentPath === '/items' ? 'active' : '' %>">
                        Ahabanza
                    </a>
                </li>

                <li class="nav-separator"><span class="nav-link" style="color:#F5C857;">|</span></li>

                <li class="nav-item">
                    <a href="/items/post-lost"
                    class="nav-link <%= currentPath === '/items/post-lost' ? 'active' : '' %>">
                        Icyangombwa Cyabuze
                    </a>
                </li>

                <li class="nav-separator"><span class="nav-link" style="color:#F5C857;">|</span></li>

                <li class="nav-item">
                    <a href="/items/post-found"
                    class="nav-link <%= currentPath === '/items/post-found' ? 'active' : '' %>">
                        Icyangombwa Cyabonetse
                    </a>
                </li>

                <li class="nav-separator"><span class="nav-link" style="color:#F5C857;">|</span></li>

                <!-- <li class="nav-item">
                    <a href="/"
                    class="nav-link <%= currentPath === '/certificates' ? 'active' : '' %>">
                        Kuramo Seritifika
                    </a>
                </li> -->
                
                <!-- <li class="nav-separator"><span class="nav-link" style="color: #F5C857;">|</span></li> -->

                <!-- 🌍 Language Switch Dropdown -->
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="languageDropdown"
                    role="button" data-bs-toggle="dropdown" aria-expanded="false"
                    style="color:#FFFFFF; font-size: 17px;">
                        <img src="/images/flags/rw.png" alt="RW" width="20" height="20" style="margin-right: 5px;"> Language
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="languageDropdown">
                        <li>
                            <a class="dropdown-item" href="?lang=rw">
                                <img src="/images/flags/rw.png" alt="RW" width="20" height="20" style="margin-right: 5px;">
                                Kinyarwanda
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item disabled" href="#"
                            tabindex="-1" aria-disabled="true">
                                <img src="/images/flags/gb.png" alt="GB" width="20" height="20" style="margin-right: 5px;">
                                English
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item disabled" href="#"
                            tabindex="-1" aria-disabled="true">
                                <img src="/images/flags/fr.png" alt="FR" width="20" height="20" style="margin-right: 5px;">
                                Français
                            </a>
                        </li>
                    </ul>
                </li>
            </ul>

        </div>
    </div>
</nav>

<div class="container" style="margin-top: 120px;">
    <%- include(viewContent) %>
</div>

<footer class="text-center text-muted" style="font-size: 12px; z-index: 1000;margin-bottom: 10px;margin-top: 15px;">
    H&G Tech Ltd, All Rights Reserved <%= new Date().getFullYear() %>
</footer>

<!-- Bootstrap JS -->
<script src="/public/js/bootstrap.bundle.min.js"></script>

<script src="/public/js/snackbar.js" defer></script>

</body>
</html>