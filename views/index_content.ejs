<!-- ================= SEARCH BAR STYLES ================= -->
<style>
    body {
        overflow-x: hidden;
    }

    .search-input,
    .search-select {
        height: 50px;
        font-size: 1rem;
        max-width: 100%;
    }

    .search-btn {
        background-color: orange;
        width: 70px;
    }
    .search-btn:hover {
        background-color: #D18700;
    }

    .card-title,
    .card-text {
        font-size: 0.95rem;
    }

    @media (max-width: 576px) {
        .card-title,
        .card-text { font-size: 0.9rem; }
        .footer{display: none;}
    }

    /* ================= SKELETON ================= */
    .skeleton {
        background: linear-gradient(
            90deg,
            #e0e0e0 25%,
            #f2f2f2 37%,
            #e0e0e0 63%
        );
        background-size: 400% 100%;
        animation: skeleton-loading 1.4s ease infinite;
        border-radius: 6px;
    }

    @keyframes skeleton-loading {
        0% { background-position: 100% 50%; }
        100% { background-position: 0 50%; }
    }

    .skeleton-img { height: 220px; width: 100%; }
    .skeleton-text { height: 14px; margin-bottom: 10px; }
    .skeleton-text.short { width: 60%; }
    .skeleton-btn { height: 36px; width: 100%; }

    /* ================= FADE EFFECT ================= */
    #skeleton-loader, #items-content {
        transition: opacity 0.8s ease;
    }
    .hidden { opacity: 0; pointer-events: none; }
    .visible { opacity: 1; pointer-events: auto; }
</style>

<!-- ================= SEARCH BAR ================= -->
<div class="container mb-4">
    <form action="/items/search" method="GET"
          class="row g-2 justify-content-center align-items-center mx-0">

        <div class="col-12 col-md-4">
            <select name="type" class="form-select search-select w-100" required>
                <option value="" disabled selected>Select Card Category</option>
                <option value="ID Card">ID Card</option>
                <option value="Bank Card">Bank Card</option>
                <option value="Passport">Passport</option>
                <option value="Driving License">Driving License</option>
            </select>
        </div>

        <div class="col-12 col-md-5">
            <div class="input-group">
                <input type="text" name="query" class="form-control search-input" placeholder="Enter your lost card number..." required>
                <button type="submit" class="btn search-btn">
                    <i class="bi bi-search text-white"></i>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ================= SKELETON LOADER ================= -->
<div id="skeleton-loader" class="row g-3"></div>

<!-- ================= REAL CONTENT ================= -->
<div id="items-content">
    <div class="row g-3" style="margin-top: 10px;">
        <% if (!items || items.length === 0) { %>
            <p class="text-muted text-center">No items found.</p>
        <% } else { %>
            <% items.forEach(item => { %>
                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm">
                        <img src="<%= item.photo_path || '/public/no-image.png' %>"
                             class="card-img-top"
                             style="height:220px; object-fit:cover;">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-center text-secondary">
                                <%= item.item_name %>
                            </h6>
                            <hr>
                            <p class="card-text flex-grow-1">
                                <span class="text-secondary">TYPE:</span> <%= item.item_type.toUpperCase() %><br>
                                <span class="text-secondary">STATUS:</span>
                                <span class="badge rounded-pill <%= item.kind === 'found' ? 'bg-success' : 'bg-danger' %>">
                                    <%= item.kind.toUpperCase() %>
                                </span><br>
                                <span class="text-secondary"><%= item.kind === 'found' ? 'LOCATION:' : 'LOCATION:' %></span>
                                <%= item.place.toUpperCase() %><br>
                                <span class="text-secondary"><%= item.kind === 'found' ? 'FINDER:' : 'OWNER:' %></span>
                                <%= item.poster_name.toUpperCase() %>
                            </p>
                            <% if (item.kind === 'found') { %>
                                <button class="btn btn-danger btn-sm w-100" style="padding: 10px 0px;font-weight: bold;">
                                    Contact Finder
                                </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>

<!-- ================= SKELETON SCRIPT WITH FADE ================= -->
<script>
document.addEventListener("DOMContentLoaded", function () {
    const skeletonContainer = document.getElementById("skeleton-loader");
    const contentContainer = document.getElementById("items-content");

    // Hide real content initially
    contentContainer.classList.add('hidden');
    
    // Generate skeleton cards dynamically
    let skeletonHTML = '';
    for (let i = 0; i < 8; i++) {
        skeletonHTML += `
        <div class="col-12 col-sm-6 col-md-4 col-lg-3">
            <div class="card h-100 shadow-sm">
                <div class="skeleton skeleton-img"></div>
                <div class="card-body">
                    <div class="skeleton skeleton-text"></div>
                    <div class="skeleton skeleton-text short"></div>
                    <div class="skeleton skeleton-text"></div>
                    <div class="skeleton skeleton-btn mt-3"></div>
                </div>
            </div>
        </div>`;
    }
    skeletonContainer.innerHTML = skeletonHTML;
    skeletonContainer.classList.add('visible');

    // After 5 seconds, fade out skeleton, fade in real content
    setTimeout(() => {
        skeletonContainer.classList.remove('visible');
        skeletonContainer.classList.add('hidden');

        contentContainer.classList.remove('hidden');
        contentContainer.classList.add('visible');
    }, 5000);
});
</script>
