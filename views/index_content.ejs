<!-- ================= SEARCH BAR STYLES ================= -->
<style>
    body {
        overflow-x: hidden;
    }

    .search-input,
    .search-select {
        height: 50px;
        font-size: 1rem;
        max-width: 100%;
    }

    .search-btn {
        background-color: orange;
        width: auto;
    }
    .search-btn:hover {
        background-color: #D18700;
    }

    .card-title,
    .card-text {
        font-size: 0.95rem;
    }

    .card-text i {
        color: #6c757d;
        vertical-align: -1px;
    }


    @media (max-width: 576px) {
        .card-title,
        .card-text { font-size: 0.9rem; }
        .footer{display: none;}
    }

    /* Responsive adjustments for mobile (phones) */
    @media (max-width: 576px) {
        .search-input,
        .search-select {
            font-size: 0.85rem;  /* smaller font for mobile */
            height: 42px;        /* reduce height slightly */
        }

        .search-btn {
            font-size: 0.85rem;  /* match button text size */
            padding: 5px 10px;   /* adjust padding for smaller height */
        }
    }
    
    /* Card image wrapper */
    .card-img-wrapper,
    .modal .card-img-wrapper {
        padding: 10px 0;              /* 20px top & bottom */
        height: 220px;                /* controls image area height */
        display: flex;
        align-items: center;          /* vertical center */
        justify-content: center;      /* horizontal center */
    }

    /* Actual image */
    .card-img-wrapper img,
    .modal .card-img-wrapper img  {
        max-height: 100%;             /* never overflow wrapper */
        max-width: 90%;               /* keep margins on sides */
        object-fit: contain;          /* no cropping */
    }

    /* Modal same size as card */
    .same-as-card {
        height: 100%;
        border-radius: 6px;
    }
</style>

<!-- ================= SEARCH BAR ================= -->
<div class="container mb-4">
    <!-- <h4 style="text-align: center;margin-bottom: 20px;color: #213448;">Murakaza neza, Shakisha icyangombwa cyawe</h4> -->
    <!-- <hr/> -->
    <form action="/items/search" method="GET"
          class="row g-2 justify-content-center align-items-center mx-0">

        <!-- Counter div (separate) -->
        <div class="col-12 col-md-3 d-flex align-items-center mb-2">
            <span style="font-weight: bold; color: #213448; white-space: nowrap;">
                <span style="text-decoration: underline;">Documents Processed:</span> <%= totalDocuments.toLocaleString() %>
            </span>
        </div>

        <!-- Select input div -->
        <div class="col-12 col-md-4 d-flex align-items-center gap-2">
            <select name="type" class="form-select search-select flex-grow-1" required>
                <option value="" disabled selected>Hitamo ubwoko bw'icyangombwa</option>
                <option value="ID Card">Indangamuntu</option>
                <option value="Passport">Pasiporo</option>
                <option value="Insurance Card">Ikarita y'ubwishingizi</option>
                <option value="Yellow Card">Karite Jone</option>               
                <option value="Driving License">Perimi yo gutwara ikinyabiziga</option>
            </select>
        </div>

        <div class="col-12 col-md-5">
            <div class="input-group">
                <input type="text" name="query" class="form-control search-input" placeholder="Nimero y'icyangombwa cyabuze..." required>
                <button type="submit" class="btn search-btn" style="padding-right: 10px;">
                    <!-- <i class="bi bi-search text-white"></i> -->
                     <span class="text-white" style="font-weight: normal;">Shakisha</span>
                </button>
            </div>
        </div>
    </form>
</div>

<!-- ================= REAL CONTENT ================= -->
<div id="items-content">
    <div class="row g-3" style="margin-top: 10px;">

        <% if (!items || items.length === 0) { %>
            <p class="text-muted text-center">No items found.</p>
        <% } else { %>

            <% items.forEach((item, index) => { %>

                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 shadow-sm" id="card-<%= index %>">

                        <!-- IMAGE -->
                        <div class="card-img-wrapper">
                            <img src="<%= '/public/images/doc_image_new.png' %>" alt="Document">
                        </div>

                        <!-- BODY -->
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title text-center text-secondary">
                                <%= item.item_name.toUpperCase() %>
                            </h6>

                            <hr>

                            <p class="card-text flex-grow-1">

                                <i class="bi bi-credit-card-2-front me-1"></i>
                                <!-- <span class="text-secondary">TYPE:</span> -->
                                <%= item.item_type.toUpperCase() %><br>

                                <i class="bi bi-info-circle-fill me-1"></i>
                                <!-- <span class="text-secondary">STATUS:</span> -->
                                <span class="badge rounded-pill bg-success">CYABONETSE</span><br>

                                <i class="bi bi-geo-alt-fill me-1"></i>
                                <!-- <span class="text-secondary">LOCATION:</span> -->
                                <%= item.place.toUpperCase() %><br>

                                <i class="bi bi-person-fill me-1"></i>
                                <!-- <span class="text-secondary">FINDER:</span> -->
                                <%= item.poster_name.toUpperCase() %>

                            </p>

                            <!-- BUTTON -->
                            <button
                                class="btn btn-sm w-100 text-white"
                                style="padding:10px 0;font-weight:normal;background:rgb(122, 122, 122);"
                                data-bs-toggle="modal"
                                data-bs-target="#contactModal-<%= index %>">
                                Contact Us
                            </button>

                        </div>
                    </div>
                </div>

                <!-- ================= MODAL ================= -->
                <div class="modal fade"
                     id="contactModal-<%= index %>"
                     tabindex="-1"
                     data-bs-backdrop="static"
                     data-bs-keyboard="false">

                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content same-as-card">

                            <div class="modal-body p-3 d-flex flex-column">

                                <!-- IMAGE -->
                                <div class="card-img-wrapper mb-2">
                                    <img src="<%= '/public/images/doc_image_new.png' %>" alt="Document">
                                </div>

                                <h6 class="text-center text-secondary">
                                    <%= item.item_name.toUpperCase() %>
                                </h6>

                                <hr>

                                <p class="flex-grow-1">

                                    <i class="bi bi-credit-card-2-front me-1"></i>
                                    <span class="text-secondary">TYPE:</span>
                                    <%= item.item_type.toUpperCase() %><br>

                                    <i class="bi bi-info-circle-fill me-1"></i>
                                    <span class="text-secondary">STATUS:</span>
                                    <span class="badge rounded-pill bg-success">CYABONETSE</span><br>

                                    <i class="bi bi-geo-alt-fill me-1"></i>
                                    <span class="text-secondary">LOCATION:</span>
                                    <%= item.place.toUpperCase() %><br>

                                    <i class="bi bi-person-fill me-1"></i>
                                    <span class="text-secondary">FINDER:</span>
                                    <%= item.poster_name.toUpperCase() %><br>

                                    <!-- NEW FIELD -->
                                    <i class="bi bi-telephone-fill me-1"></i>
                                    <span class="text-secondary">PHONE:</span>
                                    <%= item.poster_phone %>

                                </p>

                                <!-- THANK YOU BUTTON -->
                                <button
                                    type="button"
                                    class="btn text-white w-100 mt-2 mb-2"
                                    style="background:rgb(122, 122, 122);font-weight:normal; padding-top: 10px; padding-bottom: 10px;"
                                    data-bs-dismiss="modal">
                                    Murakoze
                                </button>

                            </div>
                        </div>
                    </div>
                </div>

            <% }) %>
        <% } %>
    </div>
</div>

<!-- Pagination Section -->
<% if (totalPages > 1) { %>
<div class="d-flex justify-content-center mt-4 mb-1">
    <nav>
        <ul class="pagination pagination-md">

            <!-- Previous -->
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                <a class="page-link"
                   href="/items?page=<%= currentPage - 1 %>">
                   Previous
                </a>
            </li>

            <!-- Page Numbers -->
            <% for (let i = 1; i <= totalPages; i++) { %>
                <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                    <a class="page-link" href="/items?page=<%= i %>">
                        <%= i %>
                    </a>
                </li>
            <% } %>

            <!-- Next -->
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                <a class="page-link"
                   href="/items?page=<%= currentPage + 1 %>">
                   Next
                </a>
            </li>

        </ul>
    </nav>
</div>
<% } %>

